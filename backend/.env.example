# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=project_backend.settings.prod

# --- Database -------------------------------------------------------------
# Docker exposes PostgreSQL on loopback for the host-networked backend.
DATABASE_URL=postgres://earn:change-me-db-password@127.0.0.1:5436/earn

# --- CORS / CSRF ----------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=0

# --- Researcher seed account ----------------------------------------------
RESEARCHER_USERNAME=researcher
RESEARCHER_PASSWORD=change-me-researcher-password

# --- Interactive Feedback Assistant (Condition 3) -------------------------
# Self-hosted OpenAI-compatible endpoint. No external provider fallback is used.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8123/v1
LOCAL_LLM_MODEL=openai/gpt-oss-120b
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_SECONDS=45
