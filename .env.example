# Root environment for docker-compose. Copy to .env and adjust as needed.
# (./run.sh creates this automatically from .env.example on first run.)

# --- Host ports -----------------------------------------------------------
# Defaults avoid clashing with other services already running on this machine.
WEB_PORT=3000
BACKEND_PORT=8001
# The backend uses host networking to reach the local LLM, so PostgreSQL is
# exposed on loopback for the backend process. Change this if 5436 is occupied.
DB_PORT=5436
POSTGRES_DB=earn
POSTGRES_USER=earn
POSTGRES_PASSWORD=

# Frontend -> backend URL (baked into the web build; must match BACKEND_PORT
# and be reachable from the browser).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Cross-origin (frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=0

# --- Researcher dashboard seed login --------------------------------------
RESEARCHER_USERNAME=researcher
RESEARCHER_PASSWORD=

# --- Interactive Feedback Assistant (Condition 3) -------------------------
# Local-only OpenAI-compatible model. No external provider is used if this
# endpoint fails.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8123/v1
LOCAL_LLM_MODEL=openai/gpt-oss-120b
# Optional; leave blank while the local endpoint does not require auth.
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_SECONDS=45

# --- Study conditions -----------------------------------------------------
# Conditions active in normal balanced assignment. Condition 3 (LLM-assisted)
# is optional: set to "1,2" to run a Condition 1 vs 2 study without it.
STUDY_ENABLED_CONDITIONS=1,2,3
# Use "pilot" while testing; switch to "main" before real recruitment.
STUDY_PHASE=pilot
