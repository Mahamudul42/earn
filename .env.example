# Environment for docker-compose. Copy to .env and adjust as needed.
# (./run.sh creates this automatically from .env.example on first run.)
#
# The development machine and the experiment VM run the same image; this file
# is the only thing that differs between them.

# --- Ports ----------------------------------------------------------------
# The whole application — participant site, researcher dashboard and /api/ —
# is served on this one port. Apache on the experiment VM is configured
# around 3000, so do not change it there.
APP_PORT=3000
# The app uses host networking to reach the local LLM, so PostgreSQL is
# exposed on loopback for it. Change this if 5436 is occupied.
DB_PORT=5436
POSTGRES_DB=earn
POSTGRES_USER=earn
POSTGRES_PASSWORD=

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=
# Keep this 0 anywhere that collects real participant data.
DJANGO_DEBUG=0
# Django now serves the HTML too, so this must include the hostname the
# browser uses. Behind Apache with ProxyPreserveHost that is the public
# domain, not localhost.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origin used for the Django admin's CSRF check.
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- CORS -----------------------------------------------------------------
# The frontend is same-origin, so these only matter when a Next dev server on
# another port talks to a running container (see README).
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=0

# --- Researcher dashboard seed login --------------------------------------
RESEARCHER_USERNAME=researcher
RESEARCHER_PASSWORD=

# --- Interactive Feedback Assistant (Condition 3) -------------------------
# Local-only OpenAI-compatible model, reached from the backend alone. No
# external provider is used if this endpoint fails.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8123/v1
LOCAL_LLM_MODEL=openai/gpt-oss-120b
# Optional; leave blank while the local endpoint does not require auth.
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_SECONDS=45

# --- Study conditions -----------------------------------------------------
# Conditions active in normal balanced assignment. Condition 3 (LLM-assisted)
# is optional: set to "1,2" to run a Condition 1 vs 2 study without it.
STUDY_ENABLED_CONDITIONS=1,2,3
# Use "pilot" while testing; switch to "main" before real recruitment.
STUDY_PHASE=pilot
